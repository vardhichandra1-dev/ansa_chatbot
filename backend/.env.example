# ── Application ─────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Database ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/interview_copilot

# ── Redis ───────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM Providers ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
PRIMARY_LLM_PROVIDER=anthropic
PRIMARY_MODEL=claude-sonnet-4-6          # used for guidance generation (quality)
FAST_MODEL=claude-haiku-4-5-20251001     # used for question detection + follow-up (speed)
FALLBACK_MODEL=gpt-4o

# ── Vector Store ────────────────────────────────────────────────────────────────
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=./chroma_db
PINECONE_API_KEY=
PINECONE_ENV=
PINECONE_INDEX=interview-copilot

# ── Speech ──────────────────────────────────────────────────────────────────────
WHISPER_MODEL=whisper-1
# Set to "local" to use local Whisper model, "api" for OpenAI API
TRANSCRIPTION_BACKEND=api

# ── Storage ─────────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ── CORS ────────────────────────────────────────────────────────────────────────
# "null" covers the companion app when opened as file:// in a browser
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8000","http://127.0.0.1:8000","null"]
